# URL base da API para chamadas cross-origin (ex: https://api.example.com).
# Localmente, deixe em branco para usar o proxy Vite /api -> http://api:8000.
VITE_API_URL=

# Firebase Auth (valores de configuração públicos do aplicativo Web; NÃO colocar chaves de serviço).
# No desenvolvimento Vite, o app usa automaticamente o Auth Emulator do projeto demo-habilita.
# No build para produção, preencha as 3 variáveis abaixo no ambiente de CI/deploy.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
